rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);

      match /notifications/{notificationId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.auth.uid in request.resource.data.players;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.players
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['players'])
          && request.resource.data.players.toSet()
            .difference(resource.data.players.toSet())
            .hasOnly([request.auth.uid])
          && resource.data.players.toSet()
            .difference(request.resource.data.players.toSet())
            .size() == 0
        )
      );
      allow delete: if signedIn()
        && request.auth.uid in resource.data.players;

      match /chat/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in
            get(/databases/$(database)/documents/rooms/$(roomId)).data.players;
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.players;
      allow update: if signedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.players;
    }

    match /matches/{matchId} {
      allow read, create: if signedIn();
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid);
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid);
    }

    match /friends/{friendshipId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users;
      allow read, update, delete: if signedIn()
        && request.auth.uid in resource.data.users;
    }

    match /store/{itemId} {
      allow read: if true;
    }

    match /questions/{questionId} {
      allow read: if true;
    }

    match /achievements/{achievementId} {
      allow read: if true;
    }

    match /dailyMissions/{missionId} {
      allow read: if true;
    }

    match /config/{documentId} {
      allow read: if true;
    }

    match /analytics/{eventId} {
      allow create: if signedIn();
    }

    match /reports/{reportId} {
      allow create: if signedIn();
    }

    match /invites/{inviteId} {
      allow read, create, update, delete: if signedIn();
    }

    match /queue/{entryId} {
      allow read, create, update, delete: if signedIn();
    }
  }
}
